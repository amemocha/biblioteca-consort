{
  "name": "Biblioteca Consorte",
  "short_name": "Consorte",
  "description": "Biblioteca de partituras y audios de la orquesta",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f1e6d6",
  "theme_color": "#32221e",
  "icons": [
    {
      "src": "/consorte-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "audio/*",
            "image/*",
            "application/pdf",
            ".xml",
            ".musicxml",
            ".mxl",
            ".mscz",
            ".mp3",
            ".wav",
            ".m4a",
            ".ogg"
          ]
        }
      ]
    }
  }
}